# Copiar a .env y reemplazar los valores de ejemplo por valores reales.
# .env no se versiona (ver .gitignore).

# Superusuario de PostgreSQL.
POSTGRES_PASSWORD=cambiar_en_local

# Usuario propio del esquema de ms-catedra.
CATEDRA_DB_PASSWORD=cambiar_en_local

# Usuario propio del esquema de ms-documentacion.
DOCUMENTACION_DB_PASSWORD=cambiar_en_local

# Usuario propio del esquema de ms-seguimiento.
SEGUIMIENTO_DB_PASSWORD=cambiar_en_local

# Usuario propio del esquema de Keycloak.
KEYCLOAK_DB_PASSWORD=cambiar_en_local

# Administrador de Keycloak.
KEYCLOAK_ADMIN=admin_ejemplo

# Contraseña del administrador de Keycloak.
KEYCLOAK_ADMIN_PASSWORD=cambiar_en_local

# Secreto del cliente atenas-catedra-admin.
KC_CATEDRA_ADMIN_SECRET=secreto_ejemplo_catedra

# Secreto del cliente atenas-seguimiento-job.
KC_SEGUIMIENTO_JOB_SECRET=secreto_ejemplo_seguimiento

# Clave inicial del jefe cargado en el realm.
JEFE_PASSWORD_INICIAL=cambiar_en_local

# Clave temporal asignada a docentes y alumnos nuevos (Keycloak obliga a cambiarla).
CLAVE_TEMPORAL=cambiar_en_local

# Token de servicio para la API de GitHub (5000 pedidos/hora).
GITHUB_TOKEN=token_github_de_ejemplo

# API key de Google Drive.
DRIVE_API_KEY=api_key_drive_de_ejemplo
